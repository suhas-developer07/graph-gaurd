{
  "name": "graphguard",
  "private": true,
  "version": "0.1.0",
  "description": "Continuous evaluation and release-safety system for AI agent graphs",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @graphguard/api dev",
    "dev:web": "pnpm --filter @graphguard/web dev",
    "dev:worker": "pnpm --filter @graphguard/worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @graphguard/db migrate",
    "db:generate": "pnpm --filter @graphguard/db generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.6.0",
      "vitest": "^2.1.0"
    }
  }
}
