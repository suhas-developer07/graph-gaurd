# GraphGuard Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL connection string (local Docker Compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/graphguard

# Redis connection string (local Docker Compose)
REDIS_URL=redis://localhost:6379

# Groq API key (free tier - llama models)
GROQ_API_KEY=

# Google Gemini API key (free tier - embeddings)
GEMINI_API_KEY=

# Node environment
NODE_ENV=development

# API port
PORT=4000
