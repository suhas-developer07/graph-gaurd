# GraphGuard Environment Variables
# Copy this file to .env and fill in the values

# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (local Docker Compose or hosted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/graphguard

# Redis connection string (local Docker Compose or hosted)
REDIS_URL=redis://localhost:6379

# Groq API key (free tier - llama models)
GROQ_API_KEY=

# Google Gemini API key (free tier - embeddings)
GEMINI_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Node environment (development | production | test)
NODE_ENV=development

# API port
PORT=4000

# API auth token for mutation routes (leave empty for dev mode)
API_AUTH_TOKEN=

# OpenTelemetry exporter (console | otlp)
OTEL_EXPORTER=console
